{
  "name": "@workerstack/utils",
  "version": "0.0.0",
  "private": false,
  "description": "Small helpers, one subpath export each, optional peers",
  "keywords": [
    "cache",
    "lru",
    "utils",
    "workerstack"
  ],
  "homepage": "https://github.com/workerstack/utils#readme",
  "bugs": {
    "url": "https://github.com/workerstack/utils/issues"
  },
  "license": "MIT",
  "author": "Lovro Žagar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerstack/utils.git"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "references",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./lru-cache": {
      "types": "./dist/lru-cache/index.d.ts",
      "default": "./dist/lru-cache/index.js"
    },
    "./tiered-cache": {
      "types": "./dist/tiered-cache/index.d.ts",
      "default": "./dist/tiered-cache/index.js"
    },
    "./references/*": "./references/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "repo check",
    "ci": "repo ci",
    "fmt": "repo fmt",
    "lint": "repo lint",
    "prepare": "repo sync --postinstall",
    "prepack": "bun run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "@workerstack/repo": "0.2.0-rc.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
